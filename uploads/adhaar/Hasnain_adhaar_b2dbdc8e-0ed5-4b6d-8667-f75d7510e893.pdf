  transition: transform 0.3s ease;
}
.activity-item[_ngcontent-ng-c2205322053]:hover   .activity-icon[_ngcontent-ng-c2205322053] {
  transform: rotate(10deg) scale(1.1);
  transition: transform 0.3s ease;
}
@keyframes _ngcontent-ng-c2205322053_pulse {
