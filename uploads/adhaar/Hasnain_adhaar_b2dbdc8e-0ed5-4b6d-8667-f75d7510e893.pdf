  padding: 2px 6px;
  border-radius: 10px;
  font-weight: 600;
}
@keyframes _ngcontent-ng-c2205322053_shimmer {
  0% {
    background-position: -1000px 0;
  }
  100% {
    background-position: 1000px 0;
  }
}
.skeleton[_ngcontent-ng-c2205322053] {
  background:
    linear-gradient(
      90deg,
      #f0f0f0 25%,
      #e0e0e0 50%,
      #f0f0f0 75%);
  background-size: 1000px 100%;
  animation: _ngcontent-ng-c2205322053_shimmer 1.5s infinite;
}
.stat-card[_ngcontent-ng-c2205322053]:hover   .stat-number[_ngcontent-ng-c2205322053] {
