*[_ngcontent-ng-c287643023] {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
.dashboard-container[_ngcontent-ng-c287643023] {
  display: flex;
  height: 100vh;
  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Roboto,
    Oxygen,
    Ubuntu,
    sans-serif;
}
.sidebar[_ngcontent-ng-c287643023] {
  width: 250px;
  background-color: #2c3e50;
  color: #ecf0f1;
  overflow-y: auto;
  transition: all 0.3s ease;
}
.sidebar-header[_ngcontent-ng-c287643023] {
  padding: 20px;
  background-color: #34495e;
  text-align: center;
  border-bottom: 1px solid #1a252f;
}
.sidebar-header[_ngcontent-ng-c287643023]   h2[_ngcontent-ng-c287643023] {
  font-size: 18px;
  font-weight: 600;
  letter-spacing: 0.5px;
}
.menu-list[_ngcontent-ng-c287643023] {
  list-style: none;
  padding: 10px 0;
}
.menu-item[_ngcontent-ng-c287643023] {
  position: relative;
}
.menu-link[_ngcontent-ng-c287643023] {
  display: flex;
  align-items: center;
  padding: 12px 20px;
  color: #ecf0f1;
  text-decoration: none;
  font-size: 14px;
  transition: all 0.3s ease;
  cursor: pointer;
}
.menu-link[_ngcontent-ng-c287643023]:hover {
  background-color: #34495e;
  padding-left: 25px;
}
.menu-link.active[_ngcontent-ng-c287643023] {
  background-color: #3498db;
  border-left: 4px solid #2980b9;
}
.icon[_ngcontent-ng-c287643023] {
  margin-right: 12px;
  font-size: 16px;
  width: 20px;
  text-align: center;
}
.arrow[_ngcontent-ng-c287643023] {
  margin-left: auto;
  font-size: 10px;
  transition: transform 0.3s ease;
}
.menu-item.has-submenu[_ngcontent-ng-c287643023]   .menu-link[_ngcontent-ng-c287643023]:hover   .arrow[_ngcontent-ng-c287643023] {
  transform: rotate(-180deg);
}
.submenu[_ngcontent-ng-c287643023] {
  list-style: none;
  background-color: #1a252f;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}
.submenu.show[_ngcontent-ng-c287643023] {
  max-height: 300px;
}
.submenu-link[_ngcontent-ng-c287643023] {
  display: block;
  padding: 10px 20px 10px 52px;
  color: #bdc3c7;
  text-decoration: none;
  font-size: 13px;
  transition: all 0.3s ease;
}
.submenu-link[_ngcontent-ng-c287643023]:hover {
  color: #ecf0f1;
  background-color: #2c3e50;
  padding-left: 56px;
}
.main-content[_ngcontent-ng-c287643023] {
  flex: 1;
  background-color: #f5f6fa;
  overflow-y: auto;
  padding: 20px;
}
@media (max-width: 768px) {
  .sidebar[_ngcontent-ng-c287643023] {
    width: 200px;
  }
  .sidebar-header[_ngcontent-ng-c287643023]   h2[_ngcontent-ng-c287643023] {
    font-size: 16px;
  }
  .menu-link[_ngcontent-ng-c287643023] {
    font-size: 13px;
    padding: 10px 15px;
  }
  .submenu-link[_ngcontent-ng-c287643023] {
    font-size: 12px;
    padding: 8px 15px 8px 45px;
  }
}
.sidebar[_ngcontent-ng-c287643023]::-webkit-scrollbar {
  width: 6px;
}
.sidebar[_ngcontent-ng-c287643023]::-webkit-scrollbar-track {
  background: #1a252f;
}
.sidebar[_ngcontent-ng-c287643023]::-webkit-scrollbar-thumb {
  background: #34495e;
  border-radius: 3px;
}
.sidebar[_ngcontent-ng-c287643023]::-webkit-scrollbar-thumb:hover {
  background: #4a5f7a;
}
.arrow.rotated[_ngcontent-ng-c287643023] {
  transform: rotate(-180deg);
}
.menu-link.active[_ngcontent-ng-c287643023], 
.submenu-link.active[_ngcontent-ng-c287643023] {
  background-color: #3498db;
  position: relative;
}
.menu-link.active[_ngcontent-ng-c287643023]::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4px;
  background-color: #2980b9;
}
.submenu-link.active[_ngcontent-ng-c287643023] {
  color: #ffffff;
  font-weight: 500;
}
