option_settings:
  aws:elasticbeanstalk:application:environment:
    # Database (RDS MySQL - will be set after RDS creation)
    DATABASE_URL: ${RDS_JDBC_URL}
    DATABASE_USER: ${RDS_USERNAME}
    DATABASE_PASSWORD: ${RDS_PASSWORD}
    
    # AWS S3 Configuration
    AWS_S3_ENABLED: "true"
    AWS_S3_BUCKET: campusconnect-uploads
    AWS_REGION: ap-south-1
    AWS_ACCESS_KEY_ID: "AKIA2TH5JZGCIFZ4JYXK"
    AWS_SECRET_ACCESS_KEY: "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"
    
    # Application URL (update after getting EB URL or setting up custom domain)
    APP_BASE_URL: ${APP_URL}
    
    # CORS - allow frontend domain
    CORS_ALLOWED_ORIGINS: "https://qarshistateuniversity.com,https://www.qarshistateuniversity.com"
    
    # Email Configuration (Gmail)
    MAIL_USERNAME: ${MAIL_USER}
    MAIL_PASSWORD: ${MAIL_PASS}
    ADMIN_EMAIL: ${ADMIN_MAIL}
    REPORT_EMAIL: ${REPORT_MAIL}
    
    # Production logging (reduce verbosity)
    SHOW_SQL: "false"
    SQL_LOG_LEVEL: WARN
    SECURITY_LOG_LEVEL: WARN
    
    # Scheduler
    REPORT_SCHEDULER_ENABLED: "true"
