# =====================================================
# CampusConnect - Production Environment Template
# =====================================================
# Copy this file to .env and fill in your production values
# NEVER commit the actual .env file to version control!
# =====================================================

# Database (RDS MySQL)
DATABASE_URL=jdbc:mysql://your-rds-endpoint.region.rds.amazonaws.com:3306/campusConnect
DATABASE_USER=admin
DATABASE_PASSWORD=your_secure_password_here

# Email (Gmail or SES)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your_app_password
ADMIN_EMAIL=admin@yourcompany.com
REPORT_EMAIL=reports@yourcompany.com

# AWS Configuration
AWS_S3_ENABLED=true
AWS_S3_BUCKET=campusconnect-uploads
AWS_REGION=ap-south-1

# If not using IAM role (not recommended), set these:
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# Application
APP_BASE_URL=https://api.yourcompany.com
CORS_ALLOWED_ORIGINS=https://yourcompany.com,https://www.yourcompany.com

# Logging (reduce in production)
SHOW_SQL=false
SQL_LOG_LEVEL=WARN
SECURITY_LOG_LEVEL=WARN

# Scheduler
REPORT_SCHEDULER_ENABLED=true
